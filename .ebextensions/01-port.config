# Elastic Beanstalk (Java SE platform): nginx proxies port 80 to the app on 5000.
# The application reads PORT (application.yml: server.port: ${PORT:8080}), so the
# same jar runs locally on 8080 and on Beanstalk on 5000.
#
# Credentials are NOT set here. Configure MEMBERSHIPS_ADMIN_USERNAME,
# MEMBERSHIPS_ADMIN_PASSWORD, MEMBERSHIPS_USER_USERNAME and
# MEMBERSHIPS_USER_PASSWORD as environment properties in the Beanstalk console
# or via `eb setenv`; the application refuses to start without them.
option_settings:
  aws:elasticbeanstalk:application:environment:
    PORT: 5000
